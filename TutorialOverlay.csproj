<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- a window app: no console of its own when started from a shortcut or by the plugin. Started from a terminal it
         writes into that terminal (Program.UseParentConsole); piped (the MCP stdio bridge, a script) the pipes work as usual -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- UseWPF only to get System.Windows.Automation (UIAutomationClient/Types) -->
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>12</LangVersion>
    <!-- the version: shown in the tray, settings and MCP serverInfo, stamped on the exe, names the release zip -->
    <Version>0.7.0</Version>
    <Product>TutorialOverlay</Product>
    <Copyright>Copyright (c) 2026 Nick. MIT License.</Copyright>
    <!-- keep the version plain, without "+<commit>" appended -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyName>TutorialOverlay</AssemblyName>
    <RootNamespace>TutorialOverlay</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- DPI awareness is declared in app.manifest on purpose: it must apply before any code runs -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- the plugin's skill, served to agents without the plugin by the guide tool: one text for both -->
  <ItemGroup>
    <EmbeddedResource Include="plugin/skills/tutorial-overlay/SKILL.md" LogicalName="SKILL.md" />
  </ItemGroup>
  <!-- TutorialOverlay's own words, one file per language (lang.<code>.json in the exe) -->
  <ItemGroup>
    <EmbeddedResource Include="src/lang/*.json" LogicalName="lang.%(Filename).json" />
  </ItemGroup>

  <!-- the test project lives beside the sources: keep it out of the exe -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
    <InternalsVisibleTo Include="TutorialOverlay.Tests" />
  </ItemGroup>

</Project>
