{
  "title": "FL Studio: первый паттерн",
  "app": "FL64",
  "keepOpen": true,
  "toggle": true,
  "steps": [
    {
      "id": "rack",
      "title": "Откройте Channel rack",
      "text": "Нажмите F6 или кнопку Channel rack на панели инструментов.",
      "until": [ { "type": "appear", "title": "Channel rack" } ]
    },
    {
      "id": "kick",
      "title": "Поставьте бочку на 1 и 9 шаг",
      "text": "Кликните по отмеченным ячейкам 808 Kick. Повторный клик снова выключает ячейку.",
      "anchor": { "element": { "name": "Channel rack", "role": "Pane" } },
      "checklist": true,
      "targets": [
        {
          "name": "Шаг 1",
          "shapes": [ { "type": "checkbox", "x": 324, "y": 79, "w": 22, "h": 30 } ],
          "check": { "at": [ 335, 93 ], "expr": "g>140" }
        },
        {
          "name": "Шаг 9",
          "shapes": [ { "type": "checkbox", "x": 516, "y": 79, "w": 22, "h": 30 } ],
          "check": { "at": [ 527, 93 ], "expr": "g>140" }
        }
      ]
    },
    {
      "id": "piano",
      "title": "Откройте Piano roll для FLEX Bass",
      "text": "Правый клик по имени канала → Piano roll.",
      "targets": [
        {
          "name": "FLEX Bass",
          "button": "right",
          "anchor": { "element": { "name": "Channel rack", "role": "Pane" }, "offset": [ 224, 272 ] },
          "shapes": [ { "type": "rect", "x": -62, "y": -18, "w": 124, "h": 36 }, { "type": "label", "text": "Правый клик" }, { "type": "arrow" } ]
        }
      ],
      "until": [ { "type": "appear", "title": "Piano roll" } ]
    },
    {
      "id": "close-piano",
      "title": "Закройте Piano roll",
      "text": "Крестик в правом верхнем углу окна Piano roll.",
      "until": [ { "type": "disappear", "title": "Piano roll" } ]
    }
  ]
}
