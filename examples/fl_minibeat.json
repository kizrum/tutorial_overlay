{
  "title": "FL Studio: мини-бит",
  "app": "FL64",
  "toggle": true,
  "steps": [
    {
      "id": "rack",
      "title": "Откройте Channel rack",
      "text": "Если стойка с каналами уже видна — шаг пройдёт сам. Иначе нажмите F6.",
      "until": [
        {
          "type": "appear",
          "title": "Channel rack"
        },
        {
          "type": "key",
          "keys": "F6"
        }
      ]
    },
    {
      "id": "pattern",
      "title": "Новый пустой паттерн",
      "text": "Нажмите F4 — FL создаст новый пустой паттерн и спросит его имя: нажмите Enter (или впишите имя). Если F4 не сработал, выберите пустой паттерн в списке сверху и нажмите «Готово».",
      "until": [
        {
          "type": "key",
          "keys": "F4"
        }
      ]
    },
    {
      "id": "kick",
      "title": "Бочка: 1, 5, 9, 13",
      "text": "Бочка на каждую долю — «четыре в пол». Кликните по четырём отмеченным ячейкам 808 Kick.",
      "anchor": {
        "element": {
          "name": "Channel rack",
          "role": "Pane"
        }
      },
      "checklist": true,
      "targets": [
        {
          "name": "Шаг {col}",
          "grid": {
            "from": [
              335,
              93
            ],
            "step": [
              24,
              45
            ],
            "cells": [
              1,
              5,
              9,
              13
            ],
            "w": 22,
            "h": 30
          },
          "check": {
            "expr": "lum>165"
          }
        }
      ]
    },
    {
      "id": "clap",
      "title": "Хлопок: 5 и 13",
      "text": "Хлопок на вторую и четвёртую доли. Ряд 808 Clap — второй сверху.",
      "anchor": {
        "element": {
          "name": "Channel rack",
          "role": "Pane"
        }
      },
      "checklist": true,
      "targets": [
        {
          "name": "Шаг {col}",
          "grid": {
            "from": [
              335,
              138
            ],
            "step": [
              24,
              45
            ],
            "cells": [
              5,
              13
            ],
            "w": 22,
            "h": 30
          },
          "check": {
            "expr": "lum>165"
          }
        }
      ]
    },
    {
      "id": "hat",
      "title": "Хай-хэт: 3, 7, 11, 15",
      "text": "Хай-хэт между ударами бочки — на слабые доли. Ряд 808 HiHat — третий.",
      "anchor": {
        "element": {
          "name": "Channel rack",
          "role": "Pane"
        }
      },
      "checklist": true,
      "targets": [
        {
          "name": "Шаг {col}",
          "grid": {
            "from": [
              335,
              183
            ],
            "step": [
              24,
              45
            ],
            "cells": [
              3,
              7,
              11,
              15
            ],
            "w": 22,
            "h": 30
          },
          "check": {
            "expr": "lum>165"
          }
        }
      ]
    },
    {
      "id": "play",
      "title": "Послушайте",
      "text": "Нажмите пробел — паттерн заиграет по кругу. Пробел ещё раз — стоп.",
      "until": [
        {
          "type": "key",
          "keys": "Space"
        }
      ]
    },
    {
      "id": "save",
      "title": "Бит готов!",
      "text": "Если хотите сохранить проект — Ctrl+S. Или просто нажмите «Готово».",
      "until": [
        {
          "type": "key",
          "keys": "Ctrl+S"
        }
      ]
    }
  ]
}