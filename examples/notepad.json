{
  "title": "Блокнот: знакомство",
  "app": "notepad",
  "keepOpen": true,
  "steps": [
    {
      "id": "file",
      "title": "Откройте меню «Файл»",
      "text": "Нажмите на пункт меню, обведённый рамкой.",
      "targets": [
        {
          "name": "Меню «Файл»",
          "anchor": { "element": { "name": "File", "role": "MenuItem" } },
          "shapes": [ { "type": "rect" }, { "type": "label", "text": "Сюда" }, { "type": "arrow" } ]
        }
      ]
    },
    {
      "id": "fmt",
      "title": "Три кнопки форматирования",
      "text": "Кликните по каждой — галочки в списке отметятся сами.",
      "numbered": true,
      "toggle": true,
      "targets": [
        { "name": "Жирный",      "anchor": { "element": { "name": "Bold", "role": "Button" } },          "shapes": [ { "type": "circle" } ] },
        { "name": "Курсив",      "anchor": { "element": { "name": "Italic", "role": "Button" } },        "shapes": [ { "type": "circle" } ] },
        { "name": "Зачёркнутый", "anchor": { "element": { "name": "Strikethrough", "role": "Button" } }, "shapes": [ { "type": "circle" } ] }
      ]
    },
    {
      "id": "info",
      "title": "Поле ввода",
      "text": "Шаг без целей: ждёт кнопку «Понятно» или «Готово».",
      "targets": [
        {
          "anchor": { "element": { "name": "Text editor" }, "origin": "center" },
          "shapes": [
            { "type": "info", "x": -200, "y": -80, "title": "Это редактор", "text": "Здесь вводится текст документа." },
            { "type": "button", "text": "Понятно", "id": "ok", "action": "done", "x": -70, "y": 40 }
          ]
        }
      ]
    }
  ]
}
