{
  "title": "Настройка инструмента в FL Studio",
  "app": "FL64",
  "steps": [
    {
      "id": "open",
      "title": "Откройте настройки 808 Kick",
      "text": "Щёлкните по имени канала «808 Kick» в Channel rack.",
      "why": "Имя канала — это кнопка: щелчок открывает окно инструмента. Для семпла это Sampler: громкость, панорама, обработка звука. Правый щелчок по имени открывает меню канала, а не окно.",
      "targets": [
        {
          "name": "Имя канала 808 Kick",
          "anchor": {
            "element": {
              "name": "Channel rack"
            },
            "find": {
              "text": "808 Kick"
            }
          },
          "shapes": [
            {
              "type": "rect",
              "x": -50,
              "y": -17,
              "w": 100,
              "h": 34
            },
            {
              "type": "label",
              "text": "Щёлкните здесь"
            }
          ],
          "opens": {
            "title": "808 Kick"
          }
        }
      ]
    },
    {
      "id": "vol",
      "title": "Громкость: ручка VOL",
      "text": "Наведите на ручку VOL и потяните мышью вверх (громче) или вниз (тише).",
      "why": "VOL — громкость этого канала до микшера. Сначала выравнивают громкость каналов между собой здесь, а в микшере уже сводят группы.",
      "targets": [
        {
          "name": "Ручка VOL",
          "anchor": {
            "element": {
              "name": "808 Kick"
            },
            "find": {
              "text": "VOL",
              "match": "exact"
            },
            "offset": [
              0,
              -29
            ]
          },
          "shapes": [
            {
              "type": "circle",
              "r": 17
            },
            {
              "type": "label",
              "text": "VOL — тяните вверх/вниз"
            }
          ]
        }
      ]
    },
    {
      "id": "pan",
      "title": "Панорама: ручка PAN",
      "text": "Ручка PAN двигает звук влево или вправо. Для бочки обычно оставляют по центру — просто попробуйте, как меняется звук.",
      "why": "Низкие инструменты (бочка, бас) держат по центру: так микс звучит плотнее и одинаково в наушниках и на колонках.",
      "targets": [
        {
          "name": "Ручка PAN",
          "anchor": {
            "element": {
              "name": "808 Kick"
            },
            "find": {
              "text": "PAN",
              "match": "exact"
            },
            "offset": [
              0,
              -29
            ]
          },
          "shapes": [
            {
              "type": "circle",
              "r": 17
            },
            {
              "type": "label",
              "text": "PAN"
            }
          ]
        }
      ]
    },
    {
      "id": "normalize",
      "title": "Включите Normalize",
      "text": "В блоке Precomputed effects включите переключатель Normalize.",
      "why": "Normalize поднимает семпл так, чтобы самый громкий пик был на максимуме. Удобно для тихих семплов. Выключается тем же переключателем.",
      "targets": [
        {
          "name": "Переключатель Normalize",
          "anchor": {
            "element": {
              "name": "808 Kick"
            },
            "find": {
              "text": "Normalize"
            },
            "offset": [
              -53,
              0
            ]
          },
          "shapes": [
            {
              "type": "circle",
              "r": 15
            },
            {
              "type": "label",
              "text": "Normalize"
            }
          ]
        }
      ]
    },
    {
      "id": "close",
      "title": "Закройте окно инструмента",
      "text": "Готово — закройте окно 808 Kick крестиком.",
      "why": "Настройки канала сохраняются в проекте; окно можно открыть снова тем же щелчком по имени канала.",
      "targets": [
        {
          "name": "Крестик",
          "anchor": {
            "element": {
              "name": "808 Kick"
            },
            "origin": "topright",
            "offset": [
              -19,
              20
            ]
          },
          "shapes": [
            {
              "type": "circle",
              "r": 16
            }
          ]
        }
      ],
      "until": [
        {
          "type": "disappear",
          "title": "808 Kick"
        }
      ]
    }
  ]
}
